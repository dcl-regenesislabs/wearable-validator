# Copy to deploy/.env (gitignored) and fill in. Secrets only live here, never in the repo.
CLOUDFLARE_TUNNEL_TOKEN=
ANTHROPIC_OAUTH_SETUP_TOKEN=
OPERATOR_TOKEN=
WKC_METRICS_BEARER_TOKEN=
CF_ACCESS_TEAM_DOMAIN=regenesis
CF_ACCESS_AUD=
PUBLIC_HOSTS=api.wearable-validator.dclregenesislabs.xyz
MAX_CONCURRENT_RUNS=1
# Slack notifications: one message per finished run in the curators' channel (docs/deployment.md "Slack notifications")
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SITE_URL=https://wearable-validator.dclregenesislabs.xyz
# the catalyst a run started from a shop URL or URN fetches the item from; the default is the public peer
# CATALYST_URL=https://peer.decentraland.org
# CATALYST_TIMEOUT_MS=60000
# Mesa's rendering threads for the render server (4 in the image); match the droplet's vCPUs
# LP_NUM_THREADS=8
